generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String
  photo     String?
  phone     String?
  city      String?
  country   String?
  role      String   @default("user")
  createdAt DateTime @default(now())
  trips     Trip[]
  notes     Note[]
}

model Trip {
  id          String          @id @default(cuid())
  name        String
  description String?
  coverPhoto  String?
  startDate   DateTime
  endDate     DateTime
  isPublic    Boolean         @default(false)
  status      String          @default("upcoming")
  createdAt   DateTime        @default(now())
  userId      String
  user        User            @relation(fields: [userId], references: [id])
  stops       Stop[]
  checklist   ChecklistItem[]
  notes       Note[]
  invoices    Invoice[]
}

model Stop {
  id          String     @id @default(cuid())
  tripId      String
  trip        Trip       @relation(fields: [tripId], references: [id], onDelete: Cascade)
  city        String
  country     String?
  startDate   DateTime
  endDate     DateTime
  budget      Float?
  order       Int        @default(0)
  description String?
  activities  Activity[]
}

model Activity {
  id          String  @id @default(cuid())
  stopId      String
  stop        Stop    @relation(fields: [stopId], references: [id], onDelete: Cascade)
  name        String
  type        String
  cost        Float?
  duration    String?
  description String?
}

model ChecklistItem {
  id       String  @id @default(cuid())
  tripId   String
  trip     Trip    @relation(fields: [tripId], references: [id], onDelete: Cascade)
  label    String
  category String
  packed   Boolean @default(false)
}

model Note {
  id        String   @id @default(cuid())
  tripId    String
  trip      Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  title     String
  content   String
  stopRef   String?
  dayRef    String?
  createdAt DateTime @default(now())
}

model Invoice {
  id          String        @id @default(cuid())
  tripId      String
  trip        Trip          @relation(fields: [tripId], references: [id], onDelete: Cascade)
  status      String        @default("pending")
  generatedAt DateTime      @default(now())
  travelers   String
  items       InvoiceItem[]
}

model InvoiceItem {
  id          String  @id @default(cuid())
  invoiceId   String
  invoice     Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  description String
  category    String
  qty         String?
  unitCost    Float
  amount      Float
}

model City {
  id         String  @id @default(cuid())
  name       String
  country    String
  region     String?
  costIndex  Float?
  popularity Int?
  imageUrl   String?
}

model ActivityTemplate {
  id          String  @id @default(cuid())
  cityId      String?
  name        String
  type        String
  cost        Float?
  duration    String?
  description String?
  imageUrl    String?
}

model CommunityPost {
  id          String   @id @default(cuid())
  tripId      String?
  userId      String
  title       String
  description String
  tags        String
  createdAt   DateTime @default(now())
}
